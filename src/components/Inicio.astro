---
import Header from './Header.astro';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import SystemVisual from './SystemVisual.astro';
import { profile, featuredProjects, otherProjects, workExperience, services, technologies } from '../data/portfolio';
---
<Header />
<main id="contenido">
  <section class="hero container" id="inicio" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> DESARROLLO INDEPENDIENTE <span class="eyebrow-divider">/</span> CHILE</p>
      <h1 id="hero-title">Software que<br />hace avanzar<br /><em>tu operación.</em></h1>
      <p class="hero-description">Soy Javier Placencia, Ingeniero Civil Informático. Desarrollo sistemas empresariales y software a medida para digitalizar procesos y hacer más ágil el trabajo de tu equipo.</p>
      <div class="hero-actions"><a class="button button-primary" href="#proyectos">Explorar proyectos <Icon name="arrow" size={18} /></a><a class="text-link" href="#contacto">Conversemos <Icon name="northeast" size={18} /></a></div>
      <div class="hero-signature"><span class="signature-line"></span><p>Del primer requerimiento al despliegue.<br /><strong>Un solo punto de contacto, de principio a fin.</strong></p></div>
    </div>
    <SystemVisual variant="hero" />
  </section>

  <div class="experience-strip">
    <div class="container experience-inner">
      <p>Experiencia desarrollando software para<br /><strong>operación y gestión empresarial</strong></p>
      <ul class="experience-companies" aria-label="Empresas vinculadas a mi experiencia">
        <li><strong>EFE SUR · EFE Central</strong><span>Sector ferroviario</span></li>
        <li><strong>Durban · Giorgio · Vergio</strong><span>Grupo empresarial de importadoras</span></li>
      </ul>
      <a class="strip-link" href="#experiencia" aria-label="Conocer mi experiencia profesional"><Icon name="northeast" size={24} /></a>
    </div>
  </div>

  <section class="section container projects-section" id="proyectos" aria-labelledby="projects-title">
    <div class="section-heading"><div><p class="eyebrow"><span class="section-index">01 /</span> PROYECTOS DESTACADOS</p><h2 id="projects-title">Retos reales.<br /><span>Soluciones a medida.</span></h2></div><p class="section-intro">Proyectos que combinan desarrollo de software, automatización y digitalización para resolver necesidades de gestión y operación.</p></div>
    <div class="featured-grid">{featuredProjects.map(project => <ProjectCard project={project} />)}</div>
    <div class="more-projects-heading"><div><p class="eyebrow">OTRAS IDEAS LLEVADAS A CÓDIGO</p><h3>Otros proyectos</h3></div><div class="project-filters" role="group" aria-label="Filtrar otros proyectos" hidden><button type="button" data-filter="all" aria-pressed="true">Todos <span>{String(otherProjects.length).padStart(2, '0')}</span></button><button type="button" data-filter="web" aria-pressed="false">Web</button><button type="button" data-filter="mobile" aria-pressed="false">Móvil</button></div></div>
    <p class="sr-only" id="filter-status" role="status" aria-live="polite"></p>
    <div class="other-projects-grid">{otherProjects.map(project => <article class="small-project" data-category={project.category}>
      <div class="small-project-top"><span class="project-icon"><Icon name={project.icon} size={22} /></span>{project.href ? <a class="icon-button repo-link" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Ver código de ${project.title} en GitHub (nueva pestaña)`}><Icon name="northeast" size={20} /></a> : <span class="private-label"><Icon name="lock" size={13} /> Privado</span>}</div>
      <p class="small-project-category">{project.label}</p><h4>{project.title}</h4><p class="small-project-description">{project.description}</p><ul class="tech-tags" aria-label="Tecnologías">{project.tags.map(tag => <li>{tag}</li>)}</ul>
    </article>)}</div>
    <a class="all-github text-link" href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18} /> Más código y proyectos en GitHub <Icon name="northeast" size={16} /></a>
  </section>

  <section class="services-section" id="servicios" aria-labelledby="services-title"><div class="container section">
    <div class="section-heading"><div><p class="eyebrow"><span class="section-index">02 /</span> CÓMO PUEDO AYUDARTE</p><h2 id="services-title">Tu próximo proyecto,<br /><span>bien acompañado.</span></h2></div><p class="section-intro">Trabajo como proveedor independiente de desarrollo, con experiencia en sistemas empresariales y transformación digital. Me encargo del proyecto completo, con comunicación directa y foco en tu negocio.</p></div>
    <div class="services-grid">{services.map(service => <article class="service"><div class="service-top"><Icon name={service.icon} size={30} /><span>/{service.number}</span></div><h3>{service.title}</h3><p>{service.description}</p><span class="service-tags">{service.tags}</span></article>)}</div>
    <div class="process-heading"><p>UNA IDEA. UN PROCESO CLARO.</p><span>Así trabajamos juntos</span></div>
    <ol class="process-list"><li><span>01</span><h4>Entender</h4><p>Conocer tu operación, el problema y lo que necesitas resolver.</p></li><li><span>02</span><h4>Diseñar</h4><p>Definir alcance, arquitectura y una experiencia de uso clara.</p></li><li><span>03</span><h4>Construir</h4><p>Desarrollar y validar la solución con revisiones durante el proceso.</p></li><li><span>04</span><h4>Implementar</h4><p>Preparar el despliegue y acompañar la puesta en marcha.</p></li></ol>
  </div></section>

  <section class="section container about-section" id="sobre-mi" aria-labelledby="about-title">
    <div class="about-intro"><p class="eyebrow"><span class="section-index">03 /</span> DETRÁS DEL CÓDIGO</p><div class="about-monogram" aria-hidden="true"><span>jp.</span><span class="monogram-caption">PENSAR · CONSTRUIR · RESOLVER</span><span class="monogram-corner">↗</span></div><p class="education"><Icon name="code" size={20} /><span>Ingeniería Civil Informática<br /><strong>Universidad del Bío-Bío</strong></span></p></div>
    <div class="about-copy"><h2 id="about-title">Soy Javier.<br /><span>Tu socio en tecnología.</span></h2><p class="about-lead">Conecto las necesidades del negocio con soluciones que mejoran el trabajo diario.</p><p>Soy Ingeniero Civil Informático de la Universidad del Bío-Bío, con experiencia en desarrollo Full Stack, sistemas empresariales y transformación digital. Me especializo en resolver problemas y digitalizar procesos administrativos y operacionales.</p><p>He liderado proyectos de desarrollo en EFE SUR y trabajado en transformación digital para el grupo de importadoras Durban, Giorgio y Vergio. Esa experiencia me permite abordar tanto la gestión empresarial como las necesidades de la operación.</p><p>Como desarrollador independiente, asumo la gestión del proyecto, el diseño, la programación y la implementación. Trabajo directamente contigo para construir herramientas claras, útiles y mantenibles.</p><div class="about-principles"><span><Icon name="check" size={16} /> Trato directo</span><span><Icon name="check" size={16} /> Visión integral</span><span><Icon name="check" size={16} /> Foco en el uso real</span></div>
      <div class="technology-list"><p class="eyebrow">HERRAMIENTAS CON LAS QUE CONSTRUYO</p>{technologies.map(tech => <div class="technology-row"><h3>{tech.label}</h3><p>{tech.items}</p></div>)}</div>
    </div>
    <section class="professional-experience" id="experiencia" aria-labelledby="experience-title">
      <div class="professional-experience-heading">
        <p class="eyebrow">EXPERIENCIA PROFESIONAL</p>
        <h3 id="experience-title">Tecnología al servicio del negocio.</h3>
        <p>Experiencia en sistemas de gestión, procesos administrativos y operación ferroviaria.</p>
      </div>
      <div class="work-experience-grid">
        {workExperience.map(experience => (
          <article class="work-experience-card">
            <p class="work-company">{experience.company}</p>
            <p class="work-area">{experience.area}</p>
            <h4>{experience.title}</h4>
            <p class="work-description">{experience.description}</p>
            <ul class="tech-tags" aria-label="Áreas de experiencia">{experience.scope.map(item => <li>{item}</li>)}</ul>
            <p class="work-contribution"><Icon name="check" size={18} /><span>{experience.contribution}</span></p>
          </article>
        ))}
      </div>
    </section>
  </section>

  <section class="contact-section" id="contacto" aria-labelledby="contact-title"><div class="container contact-inner"><div><p class="eyebrow"><span class="section-index">04 /</span> CONSTRUYAMOS ALGO ÚTIL</p><h2 id="contact-title">¿Un proceso por mejorar?<br /><span>Empecemos por conversar.</span></h2><p>Cuéntame qué necesita tu empresa.<br />Podemos convertirlo en tu próximo proyecto.</p><a class="button button-dark" href={`mailto:${profile.email}?subject=Conversemos%20sobre%20un%20proyecto`}>Hablemos de tu idea <Icon name="northeast" size={19} /></a></div><div class="contact-links"><a href={`mailto:${profile.email}`} class="contact-email">{profile.email} <Icon name="northeast" size={21} /></a><button type="button" class="copy-email" data-email={profile.email} hidden><Icon name="layers" size={15} /><span>Copiar correo</span></button><span class="copy-status sr-only" role="status" aria-live="polite"></span><div class="contact-socials"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="northeast" size={16} /></a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="northeast" size={16} /></a></div><span class="contact-footnote">Contacto directo. De persona a persona.</span></div></div></section>
</main>

<dialog class="project-dialog" aria-labelledby="dialog-title"><div class="dialog-header"><span class="eyebrow">CASO DE PROYECTO</span><form method="dialog"><button class="icon-button" aria-label="Cerrar detalle del proyecto"><Icon name="close" size={22} /></button></form></div><h2 id="dialog-title"></h2><div class="dialog-content"></div><div class="dialog-footer"><a class="text-link" href={`mailto:${profile.email}?subject=Consulta%20sobre%20un%20proyecto`}>Conversemos sobre tu proyecto <Icon name="northeast" size={17} /></a></div></dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.project-dialog');
  const dialogTitle = document.querySelector<HTMLElement>('#dialog-title');
  const dialogContent = document.querySelector<HTMLElement>('.dialog-content');
  let activeSummary: HTMLElement | null = null;
  if (dialog && dialogTitle && dialogContent && typeof dialog.showModal === 'function') {
    document.querySelectorAll<HTMLDetailsElement>('.case-details').forEach(details => {
      const summary = details.querySelector('summary');
      const content = details.querySelector('.case-content');
      if (!summary || !content) return;
      summary.setAttribute('aria-haspopup', 'dialog');
      summary.addEventListener('click', event => {
        event.preventDefault();
        activeSummary = summary;
        dialogTitle.textContent = details.dataset.title || '';
        dialogContent.replaceChildren(content.cloneNode(true));
        dialog.showModal();
        dialog.scrollTop = 0;
      });
    });
    const isBackdrop = (event: MouseEvent) => {
      const bounds = dialog.getBoundingClientRect();
      return event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom;
    };
    let backdropPress = false;
    dialog.addEventListener('pointerdown', event => { backdropPress = isBackdrop(event); });
    dialog.addEventListener('click', event => { if (backdropPress && isBackdrop(event)) dialog.close(); backdropPress = false; });
    dialog.addEventListener('close', () => activeSummary?.focus());
  }
  const filters = document.querySelector<HTMLElement>('.project-filters');
  const filterStatus = document.querySelector<HTMLElement>('#filter-status');
  const cards = document.querySelectorAll<HTMLElement>('.small-project');
  if (filters) {
    filters.hidden = false;
    filters.querySelectorAll<HTMLButtonElement>('button').forEach(button => {
      button.addEventListener('click', () => {
        filters.querySelectorAll('button').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        let visible = 0;
        cards.forEach(card => { card.hidden = button.dataset.filter !== 'all' && !(card.dataset.category || '').split(' ').includes(button.dataset.filter || ''); if (!card.hidden) visible++; });
        if (filterStatus) filterStatus.textContent = `${visible} proyectos mostrados`;
      });
    });
  }
  const copyButton = document.querySelector<HTMLButtonElement>('.copy-email');
  const copyStatus = document.querySelector<HTMLElement>('.copy-status');
  if (copyButton && navigator.clipboard && window.isSecureContext) {
    copyButton.hidden = false;
    let resetTimer: ReturnType<typeof setTimeout>;
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyButton.dataset.email || '');
        const label = copyButton.querySelector('span');
        if (label) label.textContent = 'Correo copiado';
        if (copyStatus) copyStatus.textContent = 'Correo copiado al portapapeles';
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => { if (label) label.textContent = 'Copiar correo'; if (copyStatus) copyStatus.textContent = ''; }, 3000);
      } catch { if (copyStatus) copyStatus.textContent = 'No fue posible copiar. Puedes seleccionar el correo o abrir el enlace para escribir.'; }
    });
  }
</script>
